# =============================================================================
# scripts/db-migrate/env.example — copie para scripts/db-migrate/.env
# =============================================================================
# .env deste diretório está no .gitignore. NUNCA commite credenciais.
#
# Onde achar cada coisa (Supabase Dashboard):
#   DB_URL      -> botão "Connect" > Direct connection (ou Session pooler)
#   URL / KEY   -> Project Settings > API  (service_role / secret key)
#
# ATENÇÃO à senha do banco: o Supabase CLI exige a connection string
# PERCENT-ENCODED. Se a senha tem @ : / ? # [ ] ou espaço, codifique:
#   @ = %40   : = %3A   / = %2F   ? = %3F   # = %23   espaço = %20
# Dica pra gerar a URL codificada sem erro:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'SUA_SENHA'
# =============================================================================

# --- ORIGEM (projeto atual, de onde tudo sai) --------------------------------
SOURCE_DB_URL="postgresql://postgres.OLDREF:SENHA_ENCODED@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
SOURCE_URL="https://OLDREF.supabase.co"
SOURCE_SERVICE_KEY="service_role_key_do_projeto_antigo"

# --- DESTINO (projeto novo, para onde tudo vai) ------------------------------
TARGET_DB_URL="postgresql://postgres.NEWREF:SENHA_ENCODED@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
TARGET_URL="https://NEWREF.supabase.co"
TARGET_SERVICE_KEY="service_role_key_do_projeto_novo"

# --- Opcional ----------------------------------------------------------------
# Tabelas de dados a NÃO copiar, além das que o CLI já exclui sozinho.
# O default abaixo descarta apenas ruído efêmero (sessões, tokens de uso único
# e o audit log interno do GoTrue, que costuma ter centenas de milhares de
# linhas e nenhum valor). Nenhuma delas afeta login: as senhas moram em
# auth.users, que VEM na cópia.
# Para uma cópia byte-a-byte inclusive do lixo, deixe a variável vazia.
EXTRA_EXCLUDES="auth.audit_log_entries auth.sessions auth.refresh_tokens auth.mfa_amr_claims auth.flow_state auth.one_time_tokens"
